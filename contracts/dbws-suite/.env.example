PRIVATE_KEY=
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGONSCAN_API_KEY=

# Required for mainnet deploys of either wave (deploy scripts refuse to run
# against mainnet without these). Optional for amoy/hardhat -- the scripts
# deploy a mock USDC stand-in automatically if unset.
USDC_TOKEN=

# Required in addition to the above for deploy:wave2:polygon. This is not a
# technical flag -- it exists so wave 2 (contracts flagged for Howey /
# CFTC / lending-license review, see README) cannot be deployed to mainnet
# by accident. Only set this once a securities/gaming/lending attorney has
# actually cleared the specific contracts you are deploying.
WAVE2_LEGAL_CLEARANCE=
