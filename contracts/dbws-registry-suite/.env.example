PRIVATE_KEY=0xyourdeployerkey
AMOY_RPC=https://rpc-amoy.polygon.technology
POLYGON_RPC=https://polygon-rpc.com
POLYGONSCAN_API_KEY=your_polygonscan_key
TREASURY_ADDRESS=0xyourtreasury

# Required for mainnet deploys (deploy.js refuses to run against mainnet
# without this). Optional for amoy/hardhat -- deploy.js deploys a MockUSDC
# stand-in automatically if unset.
# Polygon mainnet native USDC: 0x3c499c542cEF5E3811e1192ce70d8cc03d5c3359
USDC_ADDRESS=

# Required IN ADDITION to the above, only if you want NoteRegistry ($DPNOTE)
# deployed on Polygon mainnet. deploy.js otherwise skips it and deploys the
# other five registries + RevenueRouter normally. Do NOT set this until a
# securities attorney has actually cleared $DPNOTE (fixed-yield / revenue-
# participation notes sold to investors -- Reg D/Reg CF territory).
NOTE_REGISTRY_LEGAL_CLEARANCE=
