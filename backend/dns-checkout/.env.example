# Server port
PORT=4100

# Supabase (service role key -- full table access, server-side only, never
# shipped to the frontend or committed).
SUPABASE_URL=https://gcninnkvpdspqdwztjvs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Namecheap reseller API. Sandbox first, always -- see README.md for the
# signup walkthrough. NAMECHEAP_CLIENT_IP must be whitelisted in the
# Namecheap sandbox/production dashboard (Profile > Tools > API Access) or
# every call is rejected regardless of key correctness.
NAMECHEAP_API_BASE=https://api.sandbox.namecheap.com/xml.response
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=

# Markup applied over Namecheap's wholesale cost when syncing dns_tlds
# (e.g. 0.4 = 40% over wholesale). Integer-safe: applied then rounded to
# the nearest cent, never carried as a float into the database.
DNS_MARKUP_RATE=0.4

# Stripe (test mode until NOTE_REGISTRY-style human go-ahead to flip to live
# keys -- same posture as the registry suite's mainnet gate).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS: the dashboard origin allowed to call this API.
DASHBOARD_ORIGIN=http://localhost:5183
