# Which network's synced addresses to load (see scripts/sync-addresses.js).
VITE_NETWORK=localhost

# Phase 3: the backend/dns-checkout API base URL.
VITE_DNS_API_URL=http://localhost:4100

# Phase 3: Stripe publishable key (safe for the browser -- pk_test_...).
# The secret key stays server-side only, in backend/dns-checkout's .env.
VITE_STRIPE_PUBLISHABLE_KEY=
