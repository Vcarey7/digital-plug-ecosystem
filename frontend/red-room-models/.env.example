# Copy this file to .env.local and fill in your own Supabase project's values.
# Find both under Project Settings -> API in the Supabase dashboard.
# The anon key is safe to expose client-side by design — access is enforced
# by the Row Level Security policies in supabase/schema.sql, not by secrecy.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
