# Fill these in after running `npm run deploy:wave1:amoy` (or :polygon) in
# contracts/dbws-suite -- the deploy script prints all three registry
# addresses plus USDC/PLUG. This platform runs on PlugRegistry, not the
# superseded contracts/domain-registry suite.
VITE_PLUG_REGISTRY_ADDRESS=
VITE_PLUG_REGISTRAR_ADDRESS=
VITE_PLUG_RESOLVER_ADDRESS=

# USDC and $PLUG are both required -- registration/renewal is paid in one
# of these (ERC-20 pull), not native currency.
VITE_USDC_ADDRESS=
VITE_PLUG_TOKEN_ADDRESS=

# "amoy" (default, testnet) or "polygon" (mainnet)
VITE_NETWORK=amoy
