# Fill these in after running `npm run deploy:amoy` (or :polygon) in
# contracts/domain-registry -- the deploy script prints all four addresses.
VITE_DOMAIN_REGISTRY_ADDRESS=
VITE_PUBLIC_RESOLVER_ADDRESS=
VITE_BATCH_MINTING_ADDRESS=
VITE_PLUG_REGISTRAR_ADDRESS=

# Only needed if PlugRegistrar (USDC/$PLUG payments) was deployed.
VITE_USDC_ADDRESS=
VITE_PLUG_TOKEN_ADDRESS=

# "amoy" (default, testnet) or "polygon" (mainnet)
VITE_NETWORK=amoy
